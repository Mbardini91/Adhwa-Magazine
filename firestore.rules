rules_version = '2';

// مجلة أضواء — قواعد أمان الإعجابات
// كل قارئ (حساب مجهول) يملك وثيقة واحدة فقط لكل موضوع: topics/{topicId}/likes/{uid}
// لا توجد أي بيانات شخصية؛ فقط وقت الإعجاب.
service cloud.firestore {
  match /databases/{database}/documents {

    function validTopic(t) {
      return t in ['ceo-word','events','departments','outstanding','twin-fame','inspiring',
                   'spotlight','here-there','zanzibar','severance','calendar','memories',
                   'our-table','legal','positive','world-cup','channels'];
    }

    match /topics/{topicId}/likes/{uid} {
      // قراءة العدد (count) متاحة للجميع
      allow read: if validTopic(topicId);

      // إعجاب: فقط باسم المستخدم نفسه، ومرة واحدة، وبحقل وقت فقط
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validTopic(topicId)
                    && request.resource.data.keys().hasOnly(['at'])
                    && request.resource.data.at == request.time;

      // إلغاء الإعجاب: فقط صاحبه
      allow delete: if request.auth != null && request.auth.uid == uid;

      allow update: if false;
    }

    // كل شيء آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
