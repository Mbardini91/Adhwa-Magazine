rules_version = '2';

// مجلة أضواء — قواعد أمان الإعجابات
// المسار: issues/{issueId}/topics/{topicId}/likes/{uid}
// كل قارئ (حساب مجهول) يملك وثيقة واحدة فقط لكل موضوع في كل عدد.
// لا توجد أي بيانات شخصية؛ فقط وقت الإعجاب. القواعد عامة، فلا تحتاج تعديلاً مع كل عدد جديد.
service cloud.firestore {
  match /databases/{database}/documents {

    function validId(s) {
      return s is string && s.matches('^[a-z0-9-]{1,32}$');
    }

    match /issues/{issueId}/topics/{topicId}/likes/{uid} {
      // قراءة العدد (count) متاحة للجميع
      allow read: if validId(issueId) && validId(topicId);

      // إعجاب: فقط باسم المستخدم نفسه، مرة واحدة، وبحقل الوقت فقط
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validId(issueId) && validId(topicId)
                    && request.resource.data.keys().hasOnly(['at'])
                    && request.resource.data.at == request.time;

      // إلغاء الإعجاب: فقط صاحبه
      allow delete: if request.auth != null && request.auth.uid == uid;

      allow update: if false;
    }

    // كل شيء آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
